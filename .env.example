# ==========================================
# MUSIC GALLERY VISION - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Catatan: Semua variabel yang digunakan di sisi Client (Vite) MUST diawali dengan prefix 'VITE_'
# Jangan pernah memasukkan API Secret/Private Key di sini.

# App Config
VITE_APP_TITLE="Music Gallery Vision"
VITE_APP_ENV="production"

